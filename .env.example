# 复制为 .env 后填写真实值；不要提交 .env。以下仅列当前服务实际读取的配置。
# 监听地址固定为 127.0.0.1:8011，公网通过 Cloudflare Tunnel 访问。
# DeepSeek：密钥只保存在后端；模型名按自己的平台可用项填写。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash

# 商品通过固定店铺的公开 Store API 读取，不需要后台商品写权限或密钥。
# 会话使用项目内部 SQLite，不需要 PostgreSQL 或 Redis。

# 已核实的独立本机 TAYUNE Milvus，19531 属于课堂，不能复用。
# 核实独立实例/集群后才改为 true；不能仅靠换集合名确认隔离。
TAYUNE_MILVUS_URI=http://127.0.0.1:19532
TAYUNE_MILVUS_TOKEN=
TAYUNE_MILVUS_DB_NAME=default
TAYUNE_MILVUS_ISOLATED=true

# 填写现有完整模型目录；启动时只加载，不自动下载。
TAYUNE_BGE_MODEL_PATH=/absolute/path/to/bge-m3
TAYUNE_RERANK_MODEL_PATH=/absolute/path/to/bge-reranker-large
# 分类器目录固定为 data/generated/query_classifier_model_v2。

# 全站每日问答次数，按 UTC 日期计数；不等于模型调用次数或固定美元账单。
TAYUNE_DAILY_REQUEST_LIMIT=20
# 输入500字符、单会话8秒间隔、每轮最多4次图内模型/4次工具尝试由代码控制。
