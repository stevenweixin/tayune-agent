# 复制为 .env 后填写真实值；不要提交 .env。
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# DeepSeek：密钥只保存在后端。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# WooCommerce：MVP 优先使用公开 Store API。
WOOCOMMERCE_BASE_URL=https://tayunetea.com
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tayune_agent

# 已核实的独立本机 TAYUNE Milvus，19531 属于课堂，不能复用。
# 当前参考脚本只读进程环境变量，不自动加载本文件。
# 核实独立实例/集群后才改为 true；不能仅靠换集合名确认隔离。
TAYUNE_MILVUS_URI=http://127.0.0.1:19532
TAYUNE_MILVUS_TOKEN=
TAYUNE_MILVUS_DB_NAME=default
TAYUNE_MILVUS_ISOLATED=true
# 参考版集合名固定在 vector_store_1.py 中，不通过本文件切换。

# 安全与成本限制
MAX_AGENT_STEPS=8
MAX_MESSAGE_LENGTH=2000
LLM_TIMEOUT_SECONDS=30
